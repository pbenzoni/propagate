# Anthropic API key for the rewrite pipeline. Required for `npm run ingest`.
ANTHROPIC_API_KEY=sk-ant-...

# The site is noindex by default so a fresh clone/fork cannot accidentally
# enter search indexes. Flip to "false" only if you have a good reason and
# fully understand this project's research framing.
DEMO_NOINDEX=true

# Model used for rewrites. Default is the latest Sonnet.
ANTHROPIC_MODEL=claude-sonnet-4-5

# RSS source. Hardcoded in the spec but overridable for local testing.
SOURCE_RSS=https://www.rt.com/rss/news/
