---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const authors = (await getCollection('authors')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<BaseLayout title="Authors">
  <section class="max-w-5xl mx-auto">
    <div class="rule-thick mb-2"></div>
    <h1 class="font-display text-4xl md:text-5xl font-black">The Bylines</h1>
    <p class="italic mt-2">
      None of these people exist. Each one is a fictional persona attached to articles rewritten by a
      language model. The names are deliberately absurd so that no reader, even a hurried one, can
      mistake them for real reporters.
    </p>

    <div class="grid md:grid-cols-2 gap-6 mt-6">
      {authors.map((a) => (
        <article class="border-t border-inkblack pt-4">
          <div class="flex gap-4 items-start">
            {a.data.avatar && <img src={a.data.avatar} alt={a.data.name} class="w-20 h-20 border border-inkblack shrink-0" />}
            <div>
              <p class={`badge-section ${a.data.section === 'liberal' ? 'section-liberal-accent' : 'section-conservative-accent'}`}>{a.data.section}</p>
              <h2 class="font-display text-2xl font-black mt-1">
                <a href={`/authors/${a.slug}`} class="hover:underline">{a.data.name}</a>
              </h2>
              <p class="italic text-sm">{a.data.beat}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
